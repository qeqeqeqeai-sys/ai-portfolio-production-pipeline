    {
      "parameters": {
        "jsCode": "let rows = [];\n\nfor (const item of $input.all()) {\n  if (Array.isArray(item.json)) rows.push(...item.json);\n  else if (Array.isArray(item.json?.data)) rows.push(...item.json.data);\n  else if (Array.isArray(item.json?.rows)) rows.push(...item.json.rows);\n  else rows.push(item.json);\n}\n\nrows = rows\n  .filter(r => r && r.ticker)\n  .map(r => ({\n    json: {\n      ticker: String(r.ticker).trim().toUpperCase(),\n      company: r.company_name || r.company || String(r.ticker).trim().toUpperCase(),\n      company_name: r.company_name || r.company || null,\n      ai_subsector: r.ai_subsector || null\n    }\n  }));\n\nif (!rows.length) {\n  throw new Error('No active tickers found in ai_stock_universe.');\n}\n\nreturn rows;"
      },
