      "id": "4487452b-bf0d-46d9-bb70-3075b8a53a3b",
      "name": "Tavily News",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -80,
        192
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const stock = $('Split Stocks').item.json;\nconst results = $json.results || [];\n\nconst headlines = results.slice(0, 6).map(r => ({\n  title: r.title || '',\n  url: r.url || '',\n  content: r.content || '',\n  published_date: r.published_date || null\n}));\n\nfunction cleanText(s) {\n  return String(s || '')\n    .replace(/https?:\\/\\/\\S+/g, '')\n    .replace(/[^\\w\\s.,:%$+-]/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nlet text = headlines\n  .map(h => cleanText(h.title).slice(0, 180))\n  .join('. ')\n  .slice(0, 1000);\n\nif (!text) text = `${stock.company} ${stock.ticker} AI stock news`;\n\nreturn {\n  json: {\n    ...stock,\n    article_count: headlines.length,\n    headlines_json: headlines,\n    text\n  }\n};"
      },
      "id": "d12d67a7-f214-4d81-b61b-c7fa2b1dd4f6",
      "name": "Prepare Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        192
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://router.huggingface.co/hf-inference/models/ProsusAI/finbert",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer huggingface_key"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "inputs",
              "value": "={{$json.text}}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1346831-a521-4a9a-b5f4-fda6184fc35b",
      "name": "FinBERT",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        192
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const base = $('Prepare Text').item.json;\nconst raw = $json;\n\nlet rows = [];\nif (Array.isArray(raw)) rows = Array.isArray(raw[0]) ? raw[0] : raw;\n\nlet pos = 0;\nlet neg = 0;\nlet neu = 0;\n\nfor (const r of rows) {\n  const label = String(r.label || '').toLowerCase();\n  const score = Number(r.score || 0);\n  if (label.includes('positive')) pos = score;\n  if (label.includes('negative')) neg = score;\n  if (label.includes('neutral')) neu = score;\n}\n\nreturn {\n  json: {\n    ...base,\n    positive_count: pos,\n    neutral_count: neu,\n    negative_count: neg,\n    avg_sentiment_score: pos - neg\n  }\n};"
      },
      "id": "06ef1acf-6269-4c96-9599-9f77ba33f14f",
      "name": "Sentiment Calc",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        192
      ]
    },
    {
      "parameters": {
        "url": "={{'https://financialmodelingprep.com/stable/historical-price-eod/full?symbol=' + $json.ticker + '&from=' + new Date(Date.now() - 120 * 24 * 60 * 60 * 1000).toISOString().slice(0,10) + '&to=' + new Date().toISOString().slice(0,10) + '&apikey=FMP_key'}}",
        "options": {}
      },
      "id": "dce3247b-9ecd-4e1a-abed-bc428499b53d",
      "name": "FMP Price",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        816,
        224
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const base = $json;\n\nlet hist = Array.isArray(base.fmp_price_rows)\n  ? base.fmp_price_rows\n  : [];\n\nhist = hist\n  .filter(x => x && x.date && Number.isFinite(Number(x.close)))\n  .sort((a, b) => new Date(b.date) - new Date(a.date));\n\nconst volumes = hist.map(x => Number(x.volume || 0)).filter(Number.isFinite);\nconst prices = hist.map(x => Number(x.close)).filter(Number.isFinite);\n\nconst latestVolume = volumes[0] || 0;\nconst avgVol20 = volumes.slice(0, 20).reduce((a, b) => a + b, 0) / Math.max(1, volumes.slice(0, 20).length);\nconst volume_z = avgVol20 > 0 ? (latestVolume / avgVol20) - 1 : 0;\n\nconst latestPrice = prices[0] || null;\nconst price20 = prices[20] || prices[prices.length - 1] || null;\nconst trend_z = latestPrice && price20 ? latestPrice / price20 - 1 : 0;\n\nconst news_volume_z = Math.min(3, (base.article_count || 0) / 5);\nconst sentiment_z = base.avg_sentiment_score || 0;\n\nconst hype_score =\n  news_volume_z * 30 +\n  sentiment_z * 40 +\n  volume_z * 15 +\n  trend_z * 15;\n\nlet hype_regime = 'Normal';\nif (hype_score >= 70) hype_regime = 'Extreme';\nelse if (hype_score >= 40) hype_regime = 'High';\nelse if (hype_score <= -20) hype_regime = 'Negative';\n\nlet signal = 'NEUTRAL';\nlet signal_score = 0;\nlet signal_reason = 'No strong hype signal.';\n\nif (hype_score >= 40 && trend_z > 0) {\n  signal = 'WATCH_OVERHEATED';\n  signal_score = hype_score;\n  signal_reason = 'High hype score with positive price trend.';\n} else if (hype_score >= 40 && trend_z <= 0) {\n  signal = 'HYPE_WITH_WEAK_PRICE';\n  signal_score = hype_score;\n  signal_reason = 'High hype score but price trend is weak.';\n}\n\nconst run_date = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Singapore' });\n\nconst { fmp_price_rows, text, ...cleanBase } = base;\n\nreturn {\n  json: {\n    ...cleanBase,\n    run_date,\n    volume: latestVolume,\n    volume_z,\n    news_volume_z,\n    sentiment_z,\n    trend_z,\n    hype_score: Number(hype_score.toFixed(4)),\n    hype_regime,\n    hype_score_z: Number(hype_score.toFixed(4)),\n    signal,\n    signal_score: Number(signal_score.toFixed(4)),\n    signal_reason\n  }\n};"
      },
