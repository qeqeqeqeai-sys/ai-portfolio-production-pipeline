    {
      "parameters": {
        "jsCode": "const base = $('Sentiment Calc').first().json;\n\nlet hist = [];\n\nfor (const item of $input.all()) {\n  const j = item.json;\n\n  if (Array.isArray(j)) hist.push(...j);\n  else if (Array.isArray(j?.data)) hist.push(...j.data);\n  else if (Array.isArray(j?.historical)) hist.push(...j.historical);\n  else if (Array.isArray(j?.results)) hist.push(...j.results);\n  else if (j?.date) hist.push(j);\n}\n\nreturn [{\n  json: {\n    ...base,\n    fmp_price_rows: hist\n  }\n}];"
      },
