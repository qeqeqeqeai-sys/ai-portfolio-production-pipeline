      "id": "05b8ebc3-fd07-429b-af11-b7597ab3eb66",
      "name": "Get Latest Risk Score",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst row = Array.isArray(raw) ? raw[0] : raw;\n\nif (!row || !row.run_date_sgt) {\n  return [];\n}\n\nconst score = Number(row.overall_risk_score);\n\nif (!Number.isFinite(score) || score < 60) {\n  return [];\n}\n\nlet alertLevel = 'Elevated Risk Alert';\nlet emoji = '🟠';\nlet urgency = 'Monitor closely';\n\nif (score >= 75) {\n  alertLevel = 'Extreme Risk Alert';\n  emoji = '🔴';\n  urgency = 'Defensive action recommended';\n}\n\nconst subject = `${alertLevel} - Market Risk Score ${score}/100`;\n\nconst message = `${emoji} <b>${alertLevel}</b>\\n\\n` +\n`<b>Date:</b> ${row.run_date_sgt}\\n` +\n`<b>Risk Score:</b> ${score}/100\\n` +\n`<b>Signal:</b> ${row.signal_label || 'N/A'}\\n` +\n`<b>Action Bias:</b> ${row.action_bias || 'N/A'}\\n` +\n`<b>Top Driver:</b> ${row.top_risk_driver || 'N/A'}\\n\\n` +\n`<b>Explanation:</b>\\n${row.signal_explanation || row.key_drivers || 'No explanation available.'}\\n\\n` +\n`<b>Watchlist:</b>\\n${row.recommended_watchlist || 'VIX, US10Y, SPY/QQQ trend, news sentiment'}\\n\\n` +\n`<b>Action:</b> ${urgency}`;\n\nreturn [{\n  json: {\n    subject,\n    message,\n    alert_level: alertLevel,\n    risk_score: score,\n    run_date_sgt: row.run_date_sgt\n  }\n}];"
      },
